rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────
    // USERS — anyone signed in can read (needed for displaying names/photos
    // across team members), but you can only write your own doc.
    // ─────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─────────────────────────────
    // TEAMS — only members can read. Only the creator can delete.
    // Any signed-in user can create a team (they become the creator).
    // Updates (adding/removing members) allowed for existing members;
    // tighten further later if you want only the creator to remove others.
    // ─────────────────────────────
    match /teams/{teamId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.createdBy &&
        request.auth.uid in request.resource.data.members;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy
        || request.resource.data.members == resource.data.members.concat([request.auth.uid])   // accepting an invite (self-join)
        || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]) // leaving the team (self-remove)
        // No membership change at all. `preferences` is excluded here so only the
        // creator can change team settings — without this guard any member could.
        || (request.resource.data.members == resource.data.members
            && request.resource.data.get('preferences', {}) == resource.data.get('preferences', {}))
        );

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;
    }

    // ─────────────────────────────
    // TEAM INVITES — inviter or invitee can read their own invite.
    // Any signed-in user can create an invite (as the inviter).
    // Only the invitee can update it (to accept), matched by email.
    // ─────────────────────────────
    match /teamInvites/{inviteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email.lower() == resource.data.inviteeEmail ||
        request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.members
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.inviterUid;
      allow update: if request.auth != null && request.auth.token.email.lower() == resource.data.inviteeEmail;
    }

    // ─────────────────────────────
    // INVENTORY
    // ─────────────────────────────
    match /inventory/{itemId} {
      allow read, update, delete: if request.auth != null && (
        (resource.data.workspace == 'personal' && resource.data.addedBy == request.auth.uid) ||
        (resource.data.workspace != 'personal' && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.workspace)).data.members)
      );
      allow create: if request.auth != null && (
        (request.resource.data.workspace == 'personal' && request.resource.data.addedBy == request.auth.uid) ||
        (request.resource.data.workspace != 'personal' && request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.workspace)).data.members)
      );
    }

    // ─────────────────────────────
    // WORKSPACE
    // ─────────────────────────────
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null && (
        workspaceId == ('personal_' + request.auth.uid) ||
        request.auth.uid in get(/databases/$(database)/documents/teams/$(workspaceId)).data.members
      );
    }

    // ─────────────────────────────
    // TASKS — personal tasks restricted to owner. Team tasks restricted
    // to team members (checked via a get() on the team doc).
    // ─────────────────────────────
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null &&
        (
          (resource.data.workspace == 'personal' && resource.data.ownerUid == request.auth.uid) ||
          (resource.data.workspace != 'personal' &&
            request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.workspace)).data.members)
        );

      allow create: if request.auth != null &&
        (
          (request.resource.data.workspace == 'personal' && request.resource.data.ownerUid == request.auth.uid) ||
          (request.resource.data.workspace != 'personal' &&
            request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.workspace)).data.members)
      );
    }

    // ─────────────────────────────
    // TASK HISTORY — one permanent record per completion. These records remain
    // after a task is deleted, so the History page is a complete workspace log.
    // ─────────────────────────────
    match /taskHistory/{entryId} {
      allow read: if request.auth != null && (
        (resource.data.workspace == 'personal' && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.workspace != 'personal' &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.workspace)).data.members)
      );

      allow create: if request.auth != null &&
        request.resource.data.completedBy == request.auth.uid && (
          (request.resource.data.workspace == 'personal' &&
            request.resource.data.ownerUid == request.auth.uid) ||
          (request.resource.data.workspace != 'personal' &&
            request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.workspace)).data.members)
        );
    }
  }
}
